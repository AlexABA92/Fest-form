    var ajaxUrl = '@Url.Action("Index", "Registration")';
    var genreList = @Html.Raw(JsonConvert.SerializeObject(ViewData["GenreList"]));
    var categoryList = @Html.Raw(JsonConvert.SerializeObject(ViewData["categoryList"]));
    var ParticipantsNumberList = @Html.Raw(JsonConvert.SerializeObject(ViewData["ParticipantsNumberList"]));
    var num = @(Model?.Performances?.Count > 0 ? Model.Performances.Count - 1 : 0);
    var  errorsJs = @Html.Raw(JsonConvert.SerializeObject(errorsList));
    var leng = @Html.Raw(JsonConvert.SerializeObject(lang));

</script>