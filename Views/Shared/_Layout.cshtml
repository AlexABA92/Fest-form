@{
    string lang = Thread.CurrentThread.CurrentCulture.ToString();
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fest_form</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Fest_form.styles.css" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/images/ico.ico" />
</head>
<body>
<header>
            <div class="text-end me-3 pt-3 d-flex  justify-content-end">
                <button class="text-black btn btn-light dropdown d-flex" data-bs-toggle="dropdown" aria-expanded="false" href="#">
                                @switch (lang)
                                {
                                    case  "uk" :
                                        <img src="~/images/ua.svg" width="22px" alt="ua language"/>
                                        break;
                                    case "en":
                            <img src="~/images/en.svg" width="22px" alt="en language" />
                                        break;
                                    default:
                                        break;
                                }
                      </button>
                            <ul class="dropdown-menu text-start">
                                <li><a class="dropdown-item" asp-controller="Registration" asp-action="ChangeLanguage" asp-route-lang="uk"><img src="~/images/ua.svg" width="32px" alt="ua language"/> Украiнський</a></li>
                                <li><a class="dropdown-item" asp-controller="Registration" asp-action="ChangeLanguage" asp-route-lang="en"><img src="~/images/en.svg" width="32px" alt="en language" /> English</a></li>
                            </ul>  
          
         </div>
    </header>
   
    <main role="main" class="pb-3 h-100 col-12 col-lg-12 position-relative">
            @RenderBody()

    </main>



     <footer>
    </footer>
 
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
   
</body>
</html>
