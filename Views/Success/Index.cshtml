@using Fest_form.data.Entity
@using System.Web
@using Newtonsoft.Json
@model Fest_form.data.Entity.DanceTeam
@{
    ViewData["Title"] = "Success";

}

<div class="bgWhite col-10 col-lg-5 container font-simple text-center mt-1 mt-lg-4 p-5 rounded shadow">
    <a asp-action="Return" asp-controller="Success"  class="back btn btn-outline-secondary fs-6 fontSimple">
        <i class="bi bi-arrow-left-short"></i>
        @Resources.Resource.Succsses_Back</a>

    <h1 class="text-success fw-bolder pb-3">@Resources.Resource.Success</h1>
    <div class="mb-3 text-start alert alert-success ">
        <strong>@Resources.Resource.TeameName:</strong>
        <p class="text-end fw-light">@Model.TeamName</p>
    </div>
    <div class="mb-3 text-start alert alert-warning">
        <strong>@Resources.Resource.TeamLider:</strong>
        <p class="text-end fw-light">@Model.TeamLeader.PersonLastName @Model.TeamLeader.PersonName @Model.TeamLeader.PersonFatherName</p>
    </div>
    <div class="mb-3 text-start alert alert-success">
        <strong>@Resources.Resource.Mail:</strong>
        <p class="text-end fw-light">@Model.Mail</p>
    </div>
    <div class="mb-3 text-start alert alert-warning">
        <strong>@Resources.Resource.PhoneNumber:</strong>
        <p class="text-end fw-light">@Model.TeamPhoneNumber</p>
    </div>
    <div class="mb-3 text-start alert alert-success">
        <strong>@Resources.Resource.TeamLevelLabel:</strong>
        <p class="text-end fw-light">
            @{
                var teamLevelText = Model.TeamLevel == Fest_form.GlobalData.Enum.TeamLevelEnum.Amateur
        ? @Resources.Resource.OptionsToggleTeamLevelAmateur
        : @Resources.Resource.OptionsToggleTeamLevelProf;
                @teamLevelText
                ;
            }
        </p>
    </div>
    @if (Model.TeamLevel == Fest_form.GlobalData.Enum.TeamLevelEnum.Professional)
    {
        <div class="mb-3 text-start alert alert-warning">
            <strong>@Resources.Resource.Organization:</strong>
            <p class="text-end fw-light">@Model.Organization</p>
        </div>
    }
    @for (var i = 0; i < Model.Performances.Count; i++)
    {
        <div class="performance-section mb-4">
            <h2 class="text-decoration-underline mt-2 mb-2 alert alert-danger">@Resources.Resource.Performace @(i + 1)</h2>
            <div class="mb-3 text-start alert alert-success">
                <strong>@Resources.Resource.PerformanceName:</strong>
                <p class="text-end fw-light">@Model.Performances[i].PerformanceName</p>
            </div>
            @if (Model.Performances[i].Concertmaster == null)
            {
                <div class="mb-3 text-start alert alert-warning">
                    <strong>@Resources.Resource.Concertmaster:</strong>
                <p class="text-end fw-light">@Model.Performances[i]?.Concertmaster?.PersonLastName @Model.Performances[i]?.Concertmaster?.PersonName @Model.Performances[i]?.Concertmaster?.PersonFatherName</p>
            </div>
            }
            <div class="mb-3 text-start alert alert-success">
                <strong>@Resources.Resource.ChoreographerDirector:</strong>
                <p class="text-end fw-light">@Model.Performances[i].ChoreographerDirector.PersonLastName @Model.Performances[i].ChoreographerDirector.PersonName @Model.Performances[i].ChoreographerDirector.PersonFatherName</p>
            </div>
            <div class="mb-3 text-start alert alert-warning">
                <strong>@Resources.Resource.ParticipantsNameListLabel:</strong>
                <p class="text-end fw-light">@Resources.Resource.ResourceManager.GetString(Model.Performances[i].ParticipantsNumber?.Name ?? "NotFound")</p>
            </div>
            @for (var j = 1; j <= 3; j++)
            {
                var person = Model.Performances[i].ParticipantsNameList?.GetType().GetProperty($"PersonRepos{j}")?.GetValue(Model.Performances[i].ParticipantsNameList) as Person;
                if (person != null)
                {
                    @if (j % 2 == 0)
                    {
                        <div class="mb-3 text-start alert alert-warning">
                            <strong>@Resources.Resource.ParticipantNumList:</strong>
                            <p class="text-end fw-light">@person.PersonLastName @person.PersonName @person.PersonFatherName</p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 text-start alert alert-success">
                            <strong>@Resources.Resource.ParticipantNumList:</strong>
                            <p class="text-end fw-light">@person.PersonLastName @person.PersonName @person.PersonFatherName</p>
                        </div>
                    }
                }
            }
            <div class="mb-3 text-start alert alert-success">
                <strong>@Resources.Resource.GenreLabel:</strong>
                <p class="text-end fw-light">@Resources.Resource.ResourceManager.GetString(Model.Performances[i]?.Genre?.Name ?? "NotFound")</p>
            </div>

            <div class="mb-3  text-start alert alert-warning">
                <strong>@Resources.Resource.AgeGroup:</strong>
                <p class="text-end fw-light">@Resources.Resource.ResourceManager.GetString(Model.Performances[i]?.Category?.Name ?? "NotFound")</p>
            </div>
            <div class="mb-3 text-start alert alert-success">
                <strong>@Resources.Resource.StartPosition:</strong>
                <p class="text-end fw-light">
                    @if (Model.Performances[i].StartPoint == Fest_form.GlobalData.Enum.StartPointEnum.Point)
                    {
                        @Resources.Resource.Spot
                    }
                    else
                    {
                        @Resources.Resource.Backstage
                    }
                </p>
            </div>

            <div class="mb-3  text-start alert alert-warning">
                <strong>@Resources.Resource.PerfomanseTime:</strong>
                <p class="text-end fw-light">@Model.Performances[i].PerformanceTime</p>
            </div>
            @* <div class="mb-3 text-start alert alert-success">
                <strong>@Resources.Resource.UrlSoundtrack:</strong>
                <p class="text-end fw-light">@HttpUtility.UrlDecode(Model.Performances[i].PhonogramFileURL)</p>
            </div> *@
            @if (!string.IsNullOrEmpty(Model.Performances[i].YouTubeVideoURL))
            {
                <div class="mb-3  text-start alert alert-warning">
                    <strong>@Resources.Resource.YouTubeURL:</strong>
                    <p class="text-end fw-light">@Model.Performances[i].YouTubeVideoURL</p>
                </div>
            }
        </div>
        <a asp-action="Return" asp-controller="Success"  class="back btn btn-outline-secondary fs-6 fontSimple">
            <i class="bi bi-arrow-left-short"></i>
            @Resources.Resource.Succsses_Back
        </a>
    }
</div>
<script>
    var num = 0;
    var  errorsJs = "";
</script>