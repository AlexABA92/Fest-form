@model Fest_form.data.Entity.DanceTeam

@using Fest_form.data.Entity
@using Fest_form.GlobalData.Enum
@using Newtonsoft.Json
@using Fest_form.Helpers
@{
    ViewData["Title"] = @Resources.Resource.RegistrationPageTitle;
    var lang = ViewData["lang"]?.ToString();
    if (lang == null)
    {
        lang = "uk";
    }



    List<Genre> genreList = ViewData["GenreList"] as List<Genre> ?? new List<Genre>();
    List<Category> categoryList = ViewData["CategoryList"] as List<Category> ?? new List<Category>();
    List<ParticipantsNumber> participantsList = ViewData["ParticipantsNumberList"] as List<ParticipantsNumber> ?? new List<ParticipantsNumber>();

    Dictionary<string, List<string>>? errorsList = new();

    // Populate the array with error field IDs from the ModelState
    bool isErrors = false;
    // if(!ViewData.ModelState.IsValid)

    foreach (var key in ViewData.ModelState.Keys )
    {
        if (ViewData.ModelState[key]?.Errors.Count > 0)
        {
            if (!isErrors) isErrors = true;
            var errors = ViewData.ModelState[key]?.Errors;
            List<string> errorsMesage = new();
            foreach (var error in errors!)
            {
                errorsMesage.Add(error.ErrorMessage);
            }
            errorsList.Add(key, errorsMesage);
        }
    }
}

<div class="bgWhite col-11 container text-center mt-1 mt-lg-4">
    <h1 class="display-4 fontAliace  text-uppercase">@Resources.Resource.Festname</h1>
    <p class="fw-bold fs-4 mb-0">@Resources.Resource.registrationform</p>
    <p class="fw-bold fs-6  mb-1">@Resources.Resource.ForeFest</p>
    <img src="~/images/708807_012.svg" width="30%" alt="Monocrome" />
    <div class="border rounded-3 container border-secondary col-sm-11 col-12">

        <form id="regForm" asp-action="Index" method="post" asp-controller="Registration" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (!string.IsNullOrEmpty(ViewData["MailSendError"]?.ToString()))
            {
                <div class="text-danger">*@ViewData["MailSendError"]</div>
            }
            <div class="text-danger"></div>
            @if (isErrors)
            {
                <div class="text-danger fontSimple fw-bold">*@Resources.Resource.IsErrorsInForm</div>
            }
            @*TeamName*@
            <div class="form-group  text-start mb-2">
                <label asp-for="TeamName" class="control-label  mb-2" id="teamName">@Resources.Resource.TeameName :</label>
                <input asp-for="TeamName" class="form-control fontSimple" aria-describedby=@Resources.Resource.TeameName />
                <span asp-validation-for="TeamName" class="text-danger  fontError"></span>
            </div>
            @*TeamLeader*@
            <div class="form-group mb-3 text-start">
                <label class="control-label mb-2 ">@Resources.Resource.TeamLider :</label>
                <div class="form-group row align-items-center">

                    <div class="col-12 col-md-4">
                        <input asp-for="TeamLeader.PersonLastName"
                        class="form-control fontSimple mb-1"
                        aria-describedby="Person Last Name"
                        placeholder=@Resources.Resource.PersonLastNameLable />
                        <span asp-validation-for="TeamLeader.PersonLastName" class="text-danger fontError d-block"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <input asp-for="TeamLeader.PersonName"
                        class="form-control fontSimple mb-1"
                        aria-describedby="Person Name"
                        placeholder=@Resources.Resource.PersonFirstNameLable />
                        <span asp-validation-for="TeamLeader.PersonName" class="text-danger fontError d-block"></span>
                    </div>
                    @if (lang == "uk" || lang == "ru")
                    {
                        <div class="col-12 col-md-4">
                            <input asp-for="TeamLeader.PersonFatherName"
                            class="form-control fontSimple"
                            aria-describedby="Person Father Name"
                            placeholder="По батькові" />
                            <span asp-validation-for="TeamLeader.PersonFatherName" class="text-danger fontError d-block"></span>
                        </div>
                    }
                </div>



            </div>
            @*Mail*@
            <div class="form-group  text-start mb-2">
                <label asp-for="Mail" class="control-label mb-2">@Resources.Resource.Mail :</label>
                <input asp-for="Mail" type="email" class="form-control fontSimple" aria-describedby=@Resources.Resource.Mail />
                <span asp-validation-for="Mail" class="text-danger fontError"></span>
            </div>
            @*TeamPhoneNumber*@
            <div class="form-group  text-start mb-2">

                <label asp-for="TeamPhoneNumber" class="control-label mb-2">@Resources.Resource.PhoneNumber :</label>
                <input asp-for="TeamPhoneNumber" type="tel" placeholder="+380630000000 (0630080000)" class="form-control fontSimple" aria-describedby=@Resources.Resource.PhoneNumber />
                <span asp-validation-for="TeamPhoneNumber" class="text-danger fontError"></span>
            </div>
            @*TeamLevel*@
            <div class="form-group mb-2">
                <label asp-for="TeamLevel" class="control-label mb-2 d-block">@Resources.Resource.TeamLevelLabel : </label>
                <div class="btn-group btn-group-toggle" data-toggle="buttons">
                    <label class="btn btn-secondary active" id="option1">
                        <input type="radio" asp-for="TeamLevel" value="Amateur" name="TeamLevel" autocomplete="off" checked>
                        <span class="ms-1 fontSimple"> @Resources.Resource.OptionsToggleTeamLevelAmateur</span>
                    </label>
                    <label class="btn btn-secondary" id="option2">
                        <input type="radio" id="radioProf" asp-for="TeamLevel" value="Professional" name="TeamLevel" autocomplete="off">
                        <span class="ms-1 fontSimple">@Resources.Resource.OptionsToggleTeamLevelProf</span>
                    </label>
                </div>
            </div>
            <div id="organizationField" class="form-group  text-start invisible">
                <label asp-for="Organization" class="control-label mb-2">@Resources.Resource.Organization :</label>
                <input asp-for="Organization" type="text" placeholder="'@Resources.Resource.OrganizationPlaseholder'"
                class="form-control fontSimple" aria-describedby=@Resources.Resource.Organization />
                <span asp-validation-for="Organization" class="text-danger fontError"></span>
            </div>

            <h2 class="mb-3">@Resources.Resource.PerfornamceInfo</h2>
            <div id="performancesList" class="border-1 border rounded-3 border-secondary m-1">

                <div class="performanceItem m-1">
                    @*PerformanceName*@
                    <div>
                        <div class="form-group  text-start mb-2">
                            <label asp-for="Performances[0].PerformanceName"
                            id="perName"
                            data-label=@Resources.Resource.PerformanceName class="control-label mb-2">@Resources.Resource.PerformanceName :</label>
                            <input asp-for="Performances[0].PerformanceName" type="text"
                            id="Performances_0_PerformanceName" class="form-control fontSimple" aria-describedby=@Resources.Resource.PerformanceName />
                            <span asp-validation-for="Performances[0].PerformanceName" class="text-danger fontError"></span>
                        </div>
                    </div>
                    @*ChoreographerDirector*@
                    <div class="form-group mb-3 text-start">
                        <label class="control-label mb-2" id="CharLabel" data-label=@Resources.Resource.ChoreographerDirector>@Resources.Resource.ChoreographerDirector :</label>
                        <div class="form-group row align-items-center">
                            <div class="col-12 col-md-4">
                                <input asp-for="Performances[0].ChoreographerDirector.PersonLastName"
                                class="form-control fontSimple mb-1"
                                aria-describedby="Person Last Name"
                                id="LNPlaseholder"
                                data-plaseholder=@Resources.Resource.PersonLastNameLable
                                placeholder=@Resources.Resource.PersonLastNameLable />
                                <span asp-validation-for="Performances[0].ChoreographerDirector.PersonLastName" class="text-danger fontError d-block"></span>
                            </div>
                            <div class="col-12 col-md-4">
                                <input asp-for="Performances[0].ChoreographerDirector.PersonName"
                                class="form-control fontSimple mb-1"
                                aria-describedby="Person Name"
                                id="namePlaseholder" data-plaseholder=@Resources.Resource.PersonFirstNameLable placeholder=@Resources.Resource.PersonFirstNameLable />
                                <span asp-validation-for="Performances[0].ChoreographerDirector.PersonName" class="text-danger fontError d-block"></span>
                            </div>
                            @if (lang == "uk" || lang == "ru")
                            {
                                <div class="col-12 col-md-4">
                                    <input asp-for="Performances[0].ChoreographerDirector.PersonFatherName"
                                    class="form-control fontSimple"
                                    aria-describedby="Person Father Name"
                                    placeholder="По батькові" />
                                    <span asp-validation-for="Performances[0].ChoreographerDirector.PersonFatherName" class="text-danger fontError d-block"></span>
                                </div>
                            }
                        </div>
                    </div>
                    @*Concertmaster*@
                    <div class="form-group mb-3 text-start">
                        <div class="d-flex justify-content-between row">
                            <label class="control-label mb-2 col-12 col-md-6" id="ConcertmasterLabal"
                                data-label=@Resources.Resource.Concertmaster>@Resources.Resource.Concertmaster :</label>
                            <div class="form-check  mb-2 col-12 col-md-6 d-flex justify-content-center">
                                <input class="form-check-input me-2 ConcertmasterNullCheckBox" type="checkbox" 
                                value="" data-id="0">
                                <label class="form-check-label" id="checkLabel" for="flexCheckDefault" data-label="@Resources.Resource.ConcertmasterChackBox">
                                    @Resources.Resource.ConcertmasterChackBox
                                </label>
                            </div>
                         </div>
                        <div class="form-group row align-items-center">

                            <div class="col-12 col-md-4">
                                <input asp-for="Performances[0].Concertmaster.PersonLastName" 
                                       id="Performances_0_ConcertmasterPersonLastName"
                                       class="form-control fontSimple mb-1"
                                       aria-describedby="Person Last Name"
                                       placeholder=@Resources.Resource.PersonLastNameLable />
                                <span asp-validation-for="Performances[0].Concertmaster.PersonLastName" class="text-danger fontError d-block"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <input asp-for="Performances[0].Concertmaster.PersonName" 
                                       id="Performances_0_ConcertmasterPersonName"
                                       class="form-control fontSimple mb-1"
                                       aria-describedby="Person Name"
                                       placeholder=@Resources.Resource.PersonFirstNameLable />
                                <span asp-validation-for="Performances[0].Concertmaster.PersonName" class="text-danger fontError d-block"></span>
                            </div>
                            @if (lang == "uk" || lang == "ru")
                            {
                                <div class="col-12 col-md-4">
                                    <input asp-for="Performances[0].Concertmaster.PersonFatherName"
                                           id="Performances_0_ConcertmasterPersonFatherName"
                                           class="form-control fontSimple"
                                           aria-describedby="Person Father Name"
                                           placeholder="По батькові" />
                                    <span asp-validation-for="Performances[0].Concertmaster.PersonFatherName" class="text-danger fontError d-block"></span>
                                </div>
                            }
                        </div>
               
                          
                    </div>
                    
                    @*select ParticipantsNumber*@
                    <div id=personListforNum0 data-label=@Resources.Resource.ParticipantNumList>
                        <div class="container p-0 col-md-6">
                            <label for="Performances_0_ParticipantsNumberId" id="PartNameListLabel" data-label="@Resources.Resource.ParticipantsNameListLabel">@Resources.Resource.ParticipantsNameListLabel : </label>
                            <select class="form-select text-center fontSimple numSelect fw-bold mt-1" asp-for="Performances[0].ParticipantsNumberId"
                                    id="Performances_0_ParticipantsNumberId" data-id="0"
                                    name="@Html.NameFor(m=>m.Performances[0].ParticipantsNumberId)">
                                @if (Model == null || Model.Performances[0].ParticipantsNumberId == 0)
                                {
                                    <option value="" selected>------</option>
                                }
                                @foreach (var item in participantsList)
                                {
                                    @if (Model?.Performances[0].ParticipantsNumber?.Id == item.Id)
                                    {
                                        <option value="@item.Id" id=@string.Format("perNum{0}",item.Id)
                                                data-name="@Resources.Resource.ResourceManager.GetString(@item.Name)" selected>
                                            @Resources.Resource.ResourceManager.GetString(@item.Name)
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@item.Id" id=@string.Format("perNum{0}",item.Id)
                                                data-name="@Resources.Resource.ResourceManager.GetString(@item.Name)">
                                            @Resources.Resource.ResourceManager.GetString(@item.Name)
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Performances[0].ParticipantsNumberId" class="text-danger fontError"></span>
                        </div>

                        @{
                            var count = 0;
                            if (Model != null)
                                count = Math.Abs(Model.Performances[0].ParticipantsNumberId);

                            if (count > 0 && count < 4)
                            {
                                if (Model != null)
                                {
                                        @Html.Raw("<div id=\"personList0\">")
                                        ;
                                    }
                                    Model?.Performances[0]?.Participants.ForEach(p =>
                                    {
                                        if (p.Person != null)
                                        {
                                            var index = Model?.Performances[0]?.Participants.IndexOf(p) + 1;         
                                        @Html.Raw($"<div class=\"form-group mb-3 text-start\" id=\"perInput{index}\">")
                                            ; // Corrected HTML tag
                                            @Html.Raw($"<label class=\"control-label mb-2\">{Resources.Resource.ParticipantNumList} :</label>")
                                                  ;
                                        @Html.PersonReturn($"ParticipantsNameList.Person{index + 1}", p.Person)
                                            ;
                                            @Html.Raw("</div>")
                                            ; // Closing div for each person
                                        }
                                    }
                                );
                                @Html.Raw("</div>")
                                ; // Closing the main container
                            }
                        }
                    </div>
                    @*select Genre  PerformanceGroup*@
                    <div class="row row-cols-sm-2 mt-2">
                        <div>
                            <label for="Performances_0_GenreId" id="genreLabel" data-label="@Resources.Resource.GenreLabel">@Resources.Resource.GenreLabel : </label>
                            <select class="form-select text-center fontSimple fw-bold mt-1" asp-for="Performances[0].GenreId"
                                    id="Performances_0_GenreId" aria-label="Floating label select example"
                                    name="@Html.NameFor(m=>m.Performances[0].GenreId)">
                                @if (Model == null || Model.Performances[0].GenreId == 0)
                                {
                                    <option value="" selected>------</option>
                                }
                                @foreach (var item in genreList)
                                {
                                    @if (Model?.Performances[0].GenreId == item.Id)
                                    {
                                        <option value="@item.Id" id=@string.Format("genNum{0}",item.Id)
                                                data-name="@Resources.Resource.ResourceManager.GetString(@item.Name)" selected>
                                            @Resources.Resource.ResourceManager.GetString(@item.Name)
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@item.Id" id=@string.Format("genNum{0}",item.Id)
                                                data-name="@Resources.Resource.ResourceManager.GetString(@item.Name)">
                                            @Resources.Resource.ResourceManager.GetString(@item.Name)
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Performances[0].GenreId" class="text-danger fontError"></span>

                        </div>
                        <div>
                            <label for="Performances_0_PerformanceGroupId" id="ageGroupLabel" data-label="@Resources.Resource.AgeGroup">@Resources.Resource.AgeGroup : </label>
                            <select class="form-select text-center fontSimple fw-bold mt-1" asp-for="Performances[0].CategoryId"
                                    aria-label="Floating label select example" id="Performances_0_PerformanceGroupId"
                                    name="@Html.NameFor(m=>m.Performances[0].CategoryId)">
                                @if (Model == null || Model.Performances[0].CategoryId == 0)
                                {
                                    <option value="" selected>------</option>
                                }

                                @foreach (var item in categoryList)
                                {
                                    @if (Model?.Performances[0].CategoryId == item.Id)
                                    {
                                        <option value="@item.Id" id="@string.Format("ageGroup{0}",item.Id)"
                                                data-name="@string.Format("{0} - {1}",Resources.Resource.ResourceManager.GetString(@item.Name)
                                            ,Resources.Resource.ResourceManager.GetString(@item.Description))" selected>
                                            @Resources.Resource.ResourceManager.GetString(@item.Name) -
                                            @Resources.Resource.ResourceManager.GetString(@item.Description)

                                        </option>
                                    }
                                    else
                                    {

                                        <option value="@item.Id" id="@string.Format("ageGroup{0}",item.Id)"
                                                data-name="@string.Format("{0} - {1}",Resources.Resource.ResourceManager.GetString(@item.Name)
                                            ,Resources.Resource.ResourceManager.GetString(@item.Description))">
                                            @Resources.Resource.ResourceManager.GetString(@item.Name) -
                                            @Resources.Resource.ResourceManager.GetString(@item.Description)

                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Performances[0].CategoryId" class="text-danger fontError"></span>
                        </div>
                    </div>
                    <div class="row justify-content-around">
                        <div class="col-6">
                            <label for="time" id="timeLabel" data-label="@Resources.Resource.PerfomanseTime">@Resources.Resource.PerfomanseTime : </label>
                            <input type="time" asp-for="Performances[0].PerformanceTime"
                                   class="form-control col-12 col-md-3 text-center" id="time" />
                            <span asp-validation-for="Performances[0].PerformanceTime" class="text-danger fontError"></span>
                        </div>
                        <div class="col-6 ">
                            <label for="startSpot" id="spotLabel" data-label="@Resources.Resource.StartPosition">@Resources.Resource.StartPosition : </label>
                            <div class="row justify-content-md-around justify-content-center">
                                <input type="radio" class="btn-check" asp-for="Performances[0].StartPoint"
                                       name="@Html.NameFor(m=>m.Performances[0].StartPoint)" value="Wing" id="btn-check-outlined0" autocomplete="off" checked />
                                <label class="btn btn-outline-primary col-8 mb-1 col-md-4 fontSimple"
                                       for="btn-check-outlined0" id="radio1" data-label="@Resources.Resource.Backstage">@Resources.Resource.Backstage</label>
                                <input type="radio" class="btn-check " asp-for="Performances[0].StartPoint"
                                       name="@Html.NameFor(m=>m.Performances[0].StartPoint)" value="Point" id="btn-check-outlined00" autocomplete="off" />
                                <label class="btn btn-outline-primary col-8 mb-1 col-md-4 fontSimple"
                                       for="btn-check-outlined00" id="radio2" data-label="@Resources.Resource.Spot">@Resources.Resource.Spot</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group text-start mb-2 container d-none">
                        <label for="file" id="filelabel" data-label="@Resources.Resource.FileAdd">@Resources.Resource.FileAdd :</label>
                        <input type="file" asp-for="Performances[0].PhonogramFileURL"
                               name="Performances[0].PhonogramFileURL"
                               id="Performances_0_PhonogramFileURL" accept=".mp3, .wav"
                               class="form-control fontSimple" />
                    </div>
                    <div class="form-group  text-start mb-2 container">
                        <label asp-for="Performances[0].YouTubeVideoURL" class="control-label  mb-2" id="youtubeLinc"
                               data-label="@Resources.Resource.YouTubeURL">@Resources.Resource.YouTubeURL :</label>
                        <input asp-for="Performances[0].YouTubeVideoURL" class="form-control fontSimple" aria-describedby="@Resources.Resource.YouTubeURL" />
                        <span asp-validation-for="Performances[0].YouTubeVideoURL" class="text-danger  fontError"></span>
                    </div>
                </div>
                
                @if (Model != null && Model?.Performances?.Count > 1)
                {
                    for (int i = 1; i <= Model.Performances.Count - 1; i++)
                    {

                        @Html.PerformanceReturn(i, Model.Performances[i], genreList, categoryList, participantsList);
                        
                    };
                }

            </div>

            <div class="m-2">
                <button type="button" id="addP" data-param=@lang class="btn btn-success">
                    <i class="bi bi-plus-square"></i> @Resources.Resource.AddPerformance
                </button>
                <button type="submit" id="submitBtn" class="btn btn-primary" data-toggle="modal" data-target="#ModalFileLoading" >@Resources.Resource.Send</button>
            </div>

        </form>
        <div class="modal fade  col-6" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" 
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="staticBackdropLabel">@Resources.Resource.ModalHeader</h1>
                    </div>
                    <div class="modal-body">
                        <div class="modal-body">
                            <div>
                                <p>@Resources.Resource.Modal_Rules</p><span>
                                    <a href="~/v3.pdf" target="_blank">@Resources.Resource.Modal_rulesFile</a>
                                </span>
                            </div>
                            <div class="form-check ">
                                <p>@Resources.Resource.Madal_personalDataPar</p>
                                <div class="container d-flex justify-content-center">
                                    <input type="checkbox" class="form-check-input me-3 text-danger" id="modalCheck">
                                    <label class="form-check-label" for="exampleCheck1">@Resources.Resource.Modal_Agree</label>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" id="modalBtn" disabled class="btn btn-primary" data-bs-dismiss="modal">
                                Ok
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade  col-6" id="warningDialog" data-bs-backdrop="static" 
        data-bs-keyboard="false" tabindex="-1" 
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="staticBackdropLabel">@Resources.Resource.ModalWorning_header</h1>
                    </div>
                    <div class="modal-body">
                        <div class="modal-body">

                                @Resources.Resource.ModalWornong_5itemsOnli
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                                Ok
                            </button>
                        </div>
                    </div>
                </div>
            </div>  
        </div>
        <div class="modal fade  col-6"  id="ModalFileLoading" data-bs-backdrop="static"
             data-bs-keyboard="false" tabindex="-1"
             aria-labelledby="ModalFileLoading" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header text-center d-block">
                        <h1 class="modal-title fs-5" id="staticBackdropLabel">@Resources.Resource.Modal_FileLoadin_header</h1>
                    </div>
                    <div class="modal-body">
                        <div class="modal-body">
                            <img src="~/images/Eclipse@1x-0.5s-200px-200px.svg"  alt="spinner" />
                            <p>@Resources.Resource.Modal_fileLoadin_body</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


